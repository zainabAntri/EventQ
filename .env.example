# ---------------------------------------------------------------------------
# EventQ environment template.
#
# Copy to `.env` and fill in. Every variable here is validated by a zod schema
# at boot (apps/api/src/shared/config) — the API refuses to start on a missing
# or malformed value rather than failing later under load.
#
# NEVER commit a real secret. This file documents keys only.
# Production secrets live in AWS Secrets Manager; web secrets in Vercel env.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
# Matches docker-compose.yml credentials for local development.
DATABASE_URL=postgresql://eventq:eventq_local_dev@localhost:5432/eventq?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Origins / CORS ----------------------------------------------------------
# In production these are app.eventq.io and api.eventq.io — deliberately on the
# same registrable domain so SameSite=Lax cookies flow between them.
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated exact origins. Never a wildcard: a wildcard is incompatible
# with credentialed CORS requests anyway.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cookies -----------------------------------------------------------------
# Leave COOKIE_DOMAIN empty for localhost. Set to `.eventq.io` in deployed
# environments so cookies are shared between the Vercel web app and the AWS API.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string
JWT_ACCESS_TTL=15m
ATTENDEE_TOKEN_SECRET=replace-me-with-a-different-48-byte-random-string
ATTENDEE_TOKEN_TTL=12h
REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage (MinIO locally, S3 in AWS) -------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eventq-local
S3_ACCESS_KEY_ID=eventq_minio
S3_SECRET_ACCESS_KEY=eventq_minio_local_dev
S3_FORCE_PATH_STYLE=true

# --- AI (optional - the product is fully functional without it) --------------
# The default is OFF. With AI_ENABLED=false, EventQ makes zero API calls and
# costs zero. Nothing in the product requires it; every AI result is an
# enrichment that can be absent.
AI_ENABLED=false
ANTHROPIC_API_KEY=

# Models are tiered by stage rather than one model for everything, because
# ~85% of all AI volume is a single mechanical task (classifying one short
# question against a fixed taxonomy, with a schema-constrained response).
# A small model is the correct tool for that; the low-volume, high-judgement
# work gets a stronger one.
#
#   Haiku 4.5  $1 / $5   per MTok
#   Sonnet 5   $3 / $15  per MTok
#   Opus 5     $5 / $25  per MTok
#
# Estimated total at these settings: ~$1.15 per 500-question event.
# Raise any tier if output quality is not good enough - it is one value.
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_MODEL_DEDUP=claude-haiku-4-5
AI_MODEL_INSIGHT=claude-sonnet-5

# HARD per-event ceiling in micro-dollars (1_000_000 = $1.00).
# Enforced BEFORE each call, against the AiUsage ledger. On breach, AI stops
# for that event and the product keeps working normally - it never fails a
# request or blocks a question. Default 2000000 = $2.00 per event.
AI_EVENT_BUDGET_MICROS=2000000

# Global monthly kill switch, also in micro-dollars. Belt and braces against a
# runaway loop or an unexpectedly large event. Default 50000000 = $50.00.
AI_MONTHLY_BUDGET_MICROS=50000000

# --- Observability -----------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Web (apps/web) ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
